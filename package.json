{
  "name": "frontendproject",
  "version": "0.0.3",
  "description": "FrontEnd part from Ironhack Backend Project",
  "author": "Victor Martins",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "type-check": " vue-tsc --build",
