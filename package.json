    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "pinia": "~3.0.0",
    "vue": "~3.5.29",
    "vue-router": "~4.4.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "~6.0.1",
    "@vue/tsconfig": "~0.7.0",
    "typescript": "~5.6.0",
    "eslint": "~9.31.0",
    "eslint-plugin-vue": "~10.3.0",
    "vite": "~7.2.0",
    "vue-tsc": "~3.0.4"
  }
}
